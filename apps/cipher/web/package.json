{
  "name": "cipher-practice-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:fixture": "vite --host 127.0.0.1 --mode fixture",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:fixture": "npm run typecheck && vite build --mode fixture",
    "preview": "vite preview --host 127.0.0.1",
    "smoke": "node tests/smoke.mjs",
    "build:ap": "npm run typecheck && vite build --config vite.ap.config.ts",
    "smoke:ap": "node tests/ap-smoke.mjs",
    "smoke:ap-intake": "node tests/ap-intake-smoke.mjs",
    "smoke:ap-exception": "node tests/ap-exception-smoke.mjs",
    "smoke:ap-accounting": "node tests/ap-accounting-smoke.mjs",
    "build:commercial": "npm run typecheck && vite build --config vite.commercial.config.ts",
    "smoke:commercial": "node tests/commercial-smoke.mjs",
    "build:ar": "npm run typecheck && vite build --config vite.ar.config.ts",
    "smoke:ar": "node tests/ar-smoke.mjs",
    "build:library": "npm run typecheck && vite build --config vite.library.config.ts",
    "smoke:library": "node tests/library-smoke.mjs",
    "build:rfi": "npm run typecheck && vite build --config vite.rfi.config.ts",
    "smoke:rfi": "node tests/rfi-smoke.mjs"
  },
  "dependencies": {
    "@fluentui/react-components": "9.74.3",
    "@fluentui/react-icons": "2.0.331",
    "@griffel/react": "1.7.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.0",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  }
}
