  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cipher.example/schemas/canonical-v1.schema.json",
  "title": "Cipher independent canonical master/dimension manifest v1",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[45][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "conversion": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "from_unit_id": {
          "$ref": "#/$defs/uuid"
        },
        "to_unit_id": {
          "$ref": "#/$defs/uuid"
        },
        "dimension": {
          "enum": [
            "area",
            "count",
            "equipment_time",
            "labor_time",
            "length",
            "mass",
            "time",
            "volume"
          ]
        },
        "numerator": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,24}$"
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,24}$"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "id",
        "revision",
        "from_unit_id",
        "to_unit_id",
        "dimension",
        "numerator",
        "denominator",
        "source"
      ],
      "additionalProperties": false
    },
    "quantity": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "amount": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "maxLength": 50
        },
        "unit_id": {
          "$ref": "#/$defs/uuid"
        },
        "convert_to_unit_id": {
          "$ref": "#/$defs/uuid"
        }
      },
      "required": [
        "id",
        "amount",
        "unit_id"
      ],
      "additionalProperties": false
    }
  },
  "$comment": "Structural interchange schema. Server validator additionally enforces exact references, scoped company, reduced rational factors, conversion consistency, precision and current authorization."
