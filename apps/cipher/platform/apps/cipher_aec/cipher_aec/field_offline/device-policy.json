{
  "schema": "cipher.field.offline.device-policy.v1",
  "implementation": "contract_only_no_browser_vault_or_service_worker",
  "partition": ["site_origin", "company", "project", "canonical_person", "device_registration_uuid"],
  "persisted_storage": "explicit_opt_in_authenticated_encrypted_vault_required",
  "plaintext_local_storage": false,
  "persist_session_tokens_or_provider_credentials": false,
  "maximum_envelope_utf8_bytes": 262144,
  "automatic_business_apply_on_reconnect": false,
  "automatic_background_upload_of_drafts": false,
  "capture_uuid_immutable_after_sealing": true,
  "unsealed_draft_identity_is_not_capture_identity": true,
  "offline_permissions_are_not_server_authority": true,
  "reconnect": ["sign_in", "select_exact_profile_scope", "inspect_pending_capture", "review_conflict_or_original_receipt", "explicitly_stage_or_apply_selected_capture"],
  "uncertain_apply": "retain_exact_capture_uuid_and_envelope_digest_then_inspect_original_receipt_before_any_new_command",
  "conflict": "preserve_original_and_create_explicit_linked_replacement_with_new_uuid_and_current_base",
  "discard_local": "delete_profile_payload_and_key_material_without_a_server_command_or_auth_requirement",
  "discard_server": "explicit_current_project_field_write_and_expected_capture_version_redact_only_offline_payload_keep_audit_and_committed_business_receipt",
  "logout_or_profile_change": "lock_and_purge_decrypted_views_disable_sync_remove_keys_and_profile_payload_by_default",
  "revoked_access": "deny_sync_clear_decrypted_views_purge_local_profile_payload_no_other_account_replay",
  "vault_unavailable_or_quota_failure": "report_not_saved_do_not_claim_durable_offline_capture",
  "expiry": "client_must_enforce_declared_finite_profile_expiry_before_decrypt_or_sync_retention_setting_not_an_access_grant",
  "attachments": "only_exact_existing_canonical_document_revisions_in_sealed_envelopes_new_offline_binary_uploads_are_unimplemented_keep_unsealed_until_explicit_upload_and_new_seal",
  "privacy_limits": "server_plaintext_requires_private_storage_and_native_permissions_redaction_does_not_erase_existing_backups_or_business_records_no_secure_device_erasure_attestation"
}
