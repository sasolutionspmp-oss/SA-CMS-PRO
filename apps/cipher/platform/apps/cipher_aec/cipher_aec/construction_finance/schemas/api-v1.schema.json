            "$ref": "#/$defs/FinCitation"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FinUnitRecord"
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "id",
        "company",
        "project",
        "author_person",
        "author_user",
        "created_at",
        "status",
        "contract",
        "revision_number",
        "predecessor",
        "accepted_predecessor",
        "terms",
        "policy_revision",
        "sov_version",
        "currency",
        "contract_cap",
        "approved_changes",
        "source_citations",
        "units"
      ],
      "additionalProperties": false
    },
