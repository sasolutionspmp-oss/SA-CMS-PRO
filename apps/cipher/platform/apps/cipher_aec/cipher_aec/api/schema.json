        "name"
      ],
      "additionalProperties": false
    },
    "Session": {
      "type": "object",
      "properties": {
        "authenticated": {
          "const": true
        },
        "user": {
          "type": "string"
        },
        "person": {
          "$ref": "#/$defs/Person"
        },
        "companies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Company"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "site_mode": {
          "const": "synthetic"
        },
        "csrf_token": {
          "type": "string"
        },
        "company_scopes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "company": {
                "type": "string"
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "company",
              "capabilities"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "authenticated",
        "user",
        "person",
        "companies",
        "capabilities",
        "site_mode",
        "csrf_token",
        "company_scopes"
