{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cipher:api:v1",
  "title": "Cipher API v1",
  "description": "Frappe message contains schema/data/meta; errors contain schema/error/meta. POST Idempotency-Key must equal operation_id and X-Frappe-CSRF-Token is required for authenticated session commands.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "cipher.api.v1"
    },
    "request_id": {
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "data": {},
    "error": {
      "$ref": "#/$defs/Error"
    }
  },
  "required": [
    "schema",
    "request_id",
    "meta"
  ],
  "oneOf": [
    {
      "required": [
        "data"
      ]
    },
    {
      "required": [
        "error"
      ]
    }
  ],
  "$defs": {
    "Person": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        }
      },
