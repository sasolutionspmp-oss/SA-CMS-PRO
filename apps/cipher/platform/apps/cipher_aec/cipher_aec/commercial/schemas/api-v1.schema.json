{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cipher:commercial:api:v1",
  "title": "Cipher COM-01 company-scoped authored draft contracts",
  "$defs": {
    "ComPursuitFields": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 140
        },
        "sector": {
          "type": "string",
          "maxLength": 140
        },
        "delivery_method": {
          "type": "string",
          "maxLength": 140
        },
        "geography": {
          "type": "string",
          "maxLength": 140
        },
        "bid_due_at": {
          "type": "string",
          "maxLength": 140
        },
        "bid_timezone": {
          "type": "string",
          "maxLength": 140
        },
        "procurement_reference": {
          "type": "string",
          "maxLength": 140
        },
        "probability_basis": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "ComSection": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "enum": [
            "scope",
            "assumption",
            "exclusion",
            "schedule",
            "other"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 140
        },
        "text": {
          "type": "string",
          "maxLength": 12000
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "text"
      ],
      "additionalProperties": false
    },
    "ComPriceLine": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "quantity": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,9})?$"
        },
        "unit_id": {
          "type": "string",
          "format": "uuid"
        },
        "unit_revision": {
          "type": "integer",
          "minimum": 1
        },
        "rate": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,9})?$"
        },
        "item_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "alternate_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "description",
        "quantity",
        "unit_id",
        "unit_revision",
        "rate",
        "selected"
      ],
      "additionalProperties": false
    },
    "ComPricedLine": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "quantity": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,9})?$"
        },
        "unit_id": {
          "type": "string",
          "format": "uuid"
        },
        "unit_revision": {
          "type": "integer",
          "minimum": 1
        },
        "rate": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,9})?$"
        },
        "item_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "alternate_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected": {
          "type": "boolean"
        },
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,9})?$"
        }
      },
      "required": [
        "id",
        "description",
        "quantity",
        "unit_id",
        "unit_revision",
        "rate",
        "item_code",
        "alternate_group",
        "selected",
        "amount"
      ],
      "additionalProperties": false
    },
    "ComComposition": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "valid_till": {
          "type": "string",
          "format": "date"
        },
        "terms": {
          "type": "string",
          "maxLength": 24000
        },
        "sections": {
          "type": "array",
          "maxItems": 80,
          "items": {
            "$ref": "#/$defs/ComSection"
          }
        },
        "price_lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 150,
          "items": {
            "$ref": "#/$defs/ComPriceLine"
          }
        },
        "source_references": {
          "type": "array",
          "maxItems": 0
        },
        "estimate_revision": {
          "type": "null"
        },
        "price_list": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        }
      },
      "required": [
        "currency",
        "valid_till",
        "terms",
        "sections",
        "price_lines",
        "price_list"
      ],
      "additionalProperties": false
    },
    "ComPursuit": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "company": {
          "type": "string"
        },
        "author_person": {
          "type": "string"
        },
        "revision_number": {
          "type": "integer",
          "minimum": 1
        },
        "opportunity": {
          "type": "string"
        },
        "native_version": {
          "type": "string"
        },
        "party_type": {
          "enum": [
            "Customer",
            "Lead"
          ]
        },
        "party_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "fields": {
          "$ref": "#/$defs/ComPursuitFields"
        },
        "stage": {
          "const": "identified"
        }
      },
      "required": [
        "id",
        "company",
        "author_person",
        "revision_number",
        "opportunity",
        "native_version",
        "party_type",
        "party_id",
        "title",
        "fields",
        "stage"
      ],
      "additionalProperties": false
    },
    "ComProposal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "company": {
          "type": "string"
        },
        "author_person": {
          "type": "string"
        },
        "revision_number": {
          "type": "integer",
          "minimum": 1
        },
        "pursuit": {
          "type": "string",
          "format": "uuid"
        },
        "quotation": {
          "type": "string"
        },
        "party_type": {
          "enum": [
            "Customer",
            "Lead"
          ]
        },
        "party_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "current_revision": {
          "type": "string",
          "format": "uuid"
        },
        "native_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "native_version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "company",
        "author_person",
        "revision_number",
        "pursuit",
        "quotation",
        "party_type",
        "party_id",
        "title",
        "current_revision",
        "native_fingerprint",
        "native_version"
      ],
      "additionalProperties": false
    },
    "ComPricing": {
      "type": "object",
      "properties": {
        "policy": {
          "const": "native-no-tax-no-discount-half-up-v1"
        },
        "currency_exponent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComPricedLine"
          }
        },
        "total": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,9})?$"
        }
      },
      "required": [
        "policy",
        "currency_exponent",
        "lines",
        "total"
      ],
      "additionalProperties": false
    },
    "ComNativeSnapshot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "quotation_to": {
          "type": "string"
        },
        "party_name": {
          "type": "string"
        },
        "opportunity": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "valid_till": {
          "type": "string"
        },
        "terms": {
          "type": "string"
        },
        "docstatus": {
          "const": 0
        },
        "totals": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "taxes": {
          "type": "array",
          "maxItems": 0
        },
        "selling_price_list": {
          "type": "string"
        },
        "price_list_currency": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "company",
        "quotation_to",
        "party_name",
        "opportunity",
        "currency",
        "valid_till",
        "terms",
        "docstatus",
        "totals",
        "items",
        "taxes",
        "selling_price_list",
        "price_list_currency"
      ],
      "additionalProperties": false
    },
    "ComRevision": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "company": {
          "type": "string"
        },
        "author_person": {
          "type": "string"
        },
        "revision_number": {
          "type": "integer",
          "minimum": 1
        },
        "proposal": {
          "type": "string",
          "format": "uuid"
        },
        "predecessor": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "const": "draft"
        },
        "composition": {
          "$ref": "#/$defs/ComComposition"
        },
        "pricing": {
          "$ref": "#/$defs/ComPricing"
        },
        "currency_policy": {
          "type": "object",
          "properties": {
            "currency": {
              "type": "string"
            },
            "currency_exponent": {
              "type": "integer"
            },
            "fraction_units": {
              "type": "integer",
              "minimum": 1
            },
            "native_currency_version": {
              "type": "string"
            },
            "price_list": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "currency": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "version",
                "currency"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "currency",
            "currency_exponent",
            "fraction_units",
            "native_currency_version",
            "price_list"
          ],
          "additionalProperties": false
        },
        "units": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "native": {
          "$ref": "#/$defs/ComNativeSnapshot"
        },
        "native_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "company_policy": {
          "type": "object",
          "properties": {
            "base_currency": {
              "type": "string"
            },
            "native_company_version": {
              "type": "string"
            }
          },
          "required": [
            "base_currency",
            "native_company_version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "company",
        "author_person",
        "revision_number",
        "proposal",
        "predecessor",
        "status",
        "composition",
        "pricing",
        "currency_policy",
        "units",
        "native",
        "native_fingerprint",
        "company_policy"
      ],
      "additionalProperties": false
    },
    "ComProposalDetail": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "company": {
          "type": "string"
        },
        "author_person": {
          "type": "string"
        },
        "revision_number": {
          "type": "integer",
          "minimum": 1
        },
        "pursuit": {
          "type": "string",
          "format": "uuid"
        },
        "quotation": {
          "type": "string"
        },
        "party_type": {
          "enum": [
            "Customer",
            "Lead"
          ]
        },
        "party_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "current_revision": {
          "type": "string",
          "format": "uuid"
        },
        "native_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "native_version": {
          "type": "string"
        },
        "revision": {
          "$ref": "#/$defs/ComRevision"
        }
      },
      "required": [
        "id",
        "company",
        "author_person",
        "revision_number",
        "pursuit",
        "quotation",
        "party_type",
        "party_id",
        "title",
        "current_revision",
        "native_fingerprint",
        "native_version",
        "revision"
      ],
      "additionalProperties": false
    },
    "ComPursuitList": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComPursuit"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "count_mode": {
          "enum": [
            "none",
            "exact"
          ]
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "items",
        "next_cursor",
        "limit",
        "count_mode",
        "total"
      ],
      "additionalProperties": false
    },
    "ComProposalList": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComProposal"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "count_mode": {
          "enum": [
            "none",
            "exact"
          ]
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "items",
        "next_cursor",
        "limit",
        "count_mode",
        "total"
      ],
      "additionalProperties": false
    },
    "ComOperation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "const": "succeeded"
        },
        "replayed": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "status",
        "replayed"
      ],
      "additionalProperties": false
    },
    "ComPursuitCommand": {
      "type": "object",
      "properties": {
        "pursuit": {
          "$ref": "#/$defs/ComPursuit"
        },
        "operation": {
          "$ref": "#/$defs/ComOperation"
        }
      },
      "required": [
        "pursuit",
        "operation"
      ],
      "additionalProperties": false
    },
    "ComProposalCommand": {
      "type": "object",
      "properties": {
        "proposal": {
          "$ref": "#/$defs/ComProposal"
        },
        "revision": {
          "$ref": "#/$defs/ComRevision"
        },
        "operation": {
          "$ref": "#/$defs/ComOperation"
        }
      },
      "required": [
        "proposal",
        "revision",
        "operation"
      ],
      "additionalProperties": false
    },
    "ComComparison": {
      "type": "object",
      "properties": {
        "proposal_id": {
          "type": "string",
          "format": "uuid"
        },
        "left_revision": {
          "type": "string",
          "format": "uuid"
        },
        "right_revision": {
          "type": "string",
          "format": "uuid"
        },
        "changes": {
          "type": "object",
          "properties": {
            "sections": {
              "type": "object",
              "properties": {
                "added": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ComSection"
                  }
                },
                "removed": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ComSection"
                  }
                },
                "changed": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "before": {
                        "$ref": "#/$defs/ComSection"
                      },
                      "after": {
                        "$ref": "#/$defs/ComSection"
                      }
                    },
                    "required": [
                      "id",
                      "before",
                      "after"
                    ],
                    "additionalProperties": false
                  }
                },
                "order_changed": {
                  "type": "boolean"
                }
              },
              "required": [
                "added",
                "removed",
                "changed",
                "order_changed"
              ],
              "additionalProperties": false
            },
            "price_lines": {
              "type": "object",
              "properties": {
                "added": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ComPriceLine"
                  }
                },
                "removed": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ComPriceLine"
                  }
                },
                "changed": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "before": {
                        "$ref": "#/$defs/ComPriceLine"
                      },
                      "after": {
                        "$ref": "#/$defs/ComPriceLine"
                      }
                    },
                    "required": [
                      "id",
                      "before",
                      "after"
                    ],
                    "additionalProperties": false
                  }
                },
                "order_changed": {
                  "type": "boolean"
                }
              },
              "required": [
                "added",
                "removed",
                "changed",
                "order_changed"
              ],
              "additionalProperties": false
            },
            "terms": {
              "type": "object",
              "properties": {
                "before": {
                  "type": "string"
                },
                "after": {
                  "type": "string"
                },
                "changed": {
                  "type": "boolean"
                }
              },
              "required": [
                "before",
                "after",
                "changed"
              ],
              "additionalProperties": false
            },
            "validity": {
              "type": "object",
              "properties": {
                "before": {
                  "type": "string"
                },
                "after": {
                  "type": "string"
                },
                "changed": {
                  "type": "boolean"
                }
              },
              "required": [
                "before",
                "after",
                "changed"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "sections",
            "price_lines",
            "terms",
            "validity"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "proposal_id",
        "left_revision",
        "right_revision",
        "changes"
      ],
      "additionalProperties": false
    },
    "ComPursuitsRequest": {
      "type": "object",
      "properties": {
        "company": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 30
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "count_mode": {
          "enum": [
            "none",
            "exact"
          ],
          "default": "none"
        }
      },
      "required": [
        "company"
      ],
      "additionalProperties": false
    },
    "ComProposalsRequest": {
      "type": "object",
      "properties": {
        "company": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 30
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "count_mode": {
          "enum": [
            "none",
            "exact"
          ],
          "default": "none"
        }
      },
      "required": [
        "company"
      ],
      "additionalProperties": false
    },
    "ComPursuitRequest": {
      "type": "object",
      "properties": {
        "company": {
          "type": "string"
        },
        "pursuit_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "company",
        "pursuit_id"
      ],
      "additionalProperties": false
    },
    "ComProposalRequest": {
      "type": "object",
      "properties": {
        "company": {
          "type": "string"
        },
        "proposal_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "company",
        "proposal_id"
      ],
      "additionalProperties": false
    },
    "ComRevisionRequest": {
      "type": "object",
      "properties": {
        "company": {
          "type": "string"
        },
        "revision_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "company",
        "revision_id"
      ],
      "additionalProperties": false
    },
    "ComCompareRequest": {
      "type": "object",
      "properties": {
        "company": {
          "type": "string"
        },
        "proposal_id": {
          "type": "string",
          "format": "uuid"
        },
        "left_revision": {
          "type": "string",
          "format": "uuid"
        },
        "right_revision": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "company",
