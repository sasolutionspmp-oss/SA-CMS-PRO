# cipher-local.py init generates separate random values for every profile.
# Keep the completed environment private. Never commit or attach it to evidence.
CIPHER_DB_ROOT_PASSWORD=replace-with-a-unique-random-value
CIPHER_ADMIN_PASSWORD=replace-with-a-different-random-value
CIPHER_FIXTURE_PASSWORD=replace-with-another-random-value
CIPHER_IMAGE=cipher-local:framework-trial
# Trial defaults. Integration uses 18900 and 18901.
CIPHER_HTTP_PORT=18890
CIPHER_BACKEND_PORT=18891
